{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["jest", "@testing-library/jest-dom"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "isolatedModules": false
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "jest.setup.ts",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx"
  ]
}
